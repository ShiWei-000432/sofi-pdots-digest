name: Private SOFI weekly runtime
on:
  workflow_dispatch:
    inputs:
      operation:
        description: 'bootstrap once; test before activate; pause stops delivery'
        required: true
        default: check
        type: choice
        options: [check, bootstrap, test, activate, pause, weekly]
  schedule:
    - cron: '0 1 * * 5'
    - cron: '17 1 * * *'
permissions:
  contents: write
concurrency:
  group: private-sofi-runtime
  cancel-in-progress: false
jobs:
  digest:
    if: github.event.repository.private == true && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
        with:
          repository: ShiWei-000432/sofi-pdots-digest
          ref: REPLACE_WITH_REVIEWED_PUBLIC_COMMIT
          persist-credentials: false
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
        with:
          python-version: '3.12'
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '22'
      - name: Install reviewed runtime
        run: |
          python -m pip install '.[weekly,cloud]'
          npm install --global @openai/codex@0.164.0
          codex --version
      - name: Run private workflow
        env:
          GITHUB_TOKEN: ${{ github.token }}
          CLOUD_STATE_KEY: ${{ secrets.CLOUD_STATE_KEY }}
          CLOUD_BOOTSTRAP: ${{ secrets.CLOUD_BOOTSTRAP }}
          CLOUD_OPERATION: ${{ inputs.operation || 'check' }}
        run: python -m paper_digest.weekly.cloud
